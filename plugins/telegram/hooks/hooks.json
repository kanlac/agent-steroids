{
  "description": "Telegram time awareness injection",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_telegram_telegram__react",
        "hooks": [
          {
            "type": "command",
            "command": "date '+%Y-%m-%d %H:%M %Z'",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
