[
  {"id": "form", "lang": "en", "type": "form",
   "url": "https://httpbin.org/forms/post",
   "goal": "Fill the pizza order form: customer name, telephone, e-mail, size Medium, toppings Bacon and Mushroom, preferred delivery time 18:30, delivery instructions. Then submit the order. Stop when the JSON result page is shown.",
   "values": {"name": "Ada Lovelace", "telephone": "555-0100", "email": "ada@example.com", "delivery_time": "18:30", "instructions": "Ring twice"},
   "accept": "(()=>{try{const j=JSON.parse(document.body.innerText);return j.form.custname==='Ada Lovelace'&&j.form.size==='medium'&&j.form.delivery==='18:30'&&(j.form.topping||[]).sort().join()==='bacon,mushroom'&&j.form.comments==='Ring twice'}catch(e){return false}})()",
   "expected": ["TYPE \"Ada Lovelace\"", "TYPE \"555-0100\"", "TYPE \"ada@example.com\"", "CLICK .*Medium", "CLICK .*Bacon", "CLICK .*Mushroom", "TYPE \"18:30\"", "TYPE \"Ring twice\"", "CLICK .*Submit"]},

  {"id": "flights-search", "lang": "en", "type": "form",
   "url": "https://www.google.com/travel/flights?hl=en",
   "goal": "Find one-way flights from Zurich to London departing on October 20, 2026, for one adult in economy. Stop when matching flight options are visible.",
   "values": {"origin": "Zurich", "destination": "London"},
   "accept": "(()=>{const t=document.body.innerText;return /Z[üu]rich to London/.test(document.title)&&/One way/.test(t)&&[...document.querySelectorAll('input')].some(i=>/Oct 20/.test(i.value))&&[...document.querySelectorAll('li')].some(l=>/ZRH/.test(l.innerText))})()",
   "expected": ["CLICK .*ticket type", "CLICK .*One way", "TYPE \"Zurich\"", "CLICK .*Zurich", "TYPE \"London\"", "CLICK .*London", "CLICK .*Departure", "CLICK .*\"20", "CLICK .*Done", "CLICK .*Search"]},

  {"id": "flights-nonstop", "lang": "en", "type": "filter",
   "url": "https://www.google.com/travel/flights?hl=en",
   "goal": "Search one-way flights from Zurich to London departing October 20, 2026, one adult, economy. Once results are shown, open the Stops filter and choose 'Nonstop only'. Stop when the results list shows only nonstop flights.",
   "values": {"origin": "Zurich", "destination": "London"},
   "accept": "(()=>{const t=document.body.innerText;const vis=[...document.querySelectorAll('li')].filter(l=>l.checkVisibility()&&/ZRH/.test(l.innerText));return /One way/.test(t)&&/All filters \\(1\\)/.test(t)&&vis.length>0&&vis.every(l=>!/1 stop|2 stops/.test(l.innerText))})()",
   "expected": ["CLICK .*ticket type", "CLICK .*One way", "TYPE \"Zurich\"", "CLICK .*Zurich", "TYPE \"London\"", "CLICK .*London", "CLICK .*Departure", "CLICK .*\"20", "CLICK .*Done", "CLICK .*Search", "CLICK .*Stops", "CLICK .*Nonstop only"]},

  {"id": "zhwiki", "lang": "zh", "type": "navigate",
   "url": "https://zh.wikipedia.org/wiki/Wikipedia:%E9%A6%96%E9%A1%B5",
   "goal": "用页面上的搜索框搜索「哥德尔不完备定理」并进入该条目页面。当条目正文显示出来时停止。",
   "values": {"关键词": "哥德尔不完备定理"},
   "accept": "decodeURIComponent(location.pathname).endsWith('/哥德尔不完备定理')&&!!document.querySelector('#mw-content-text p')",
   "expected": ["TYPE \"哥德尔不完备定理\"", "(PRESS_ENTER|CLICK .*搜索|CLICK .*哥德尔)"]},

  {"id": "enwiki", "lang": "en", "type": "navigate",
   "url": "https://en.wikipedia.org/wiki/Main_Page",
   "goal": "Use the search box to search for Gödel's incompleteness theorems and open that article. Stop when the article body is visible.",
   "values": {"query": "Gödel's incompleteness theorems"},
   "accept": "location.pathname==='/wiki/G%C3%B6del%27s_incompleteness_theorems'&&!!document.querySelector('#mw-content-text p')",
   "expected": ["TYPE \"Gödel", "(PRESS_ENTER|CLICK .*Search|CLICK .*Gödel)"]},

  {"id": "zhihu-question", "lang": "zh", "type": "navigate",
   "url": "https://www.zhihu.com/",
   "goal": "在顶部搜索框搜索「大语言模型 教育」。在搜索结果里找到第一条问题（标题以「?」或「？」结尾的条目）并打开它。当问题页显示出回答列表时停止。",
   "values": {"关键词": "大语言模型 教育"},
   "accept": "/^\\/question\\/\\d+/.test(location.pathname)&&document.querySelectorAll('.AnswerItem, .ContentItem').length>0",
   "expected": ["TYPE \"大语言模型 教育\"", "(PRESS_ENTER|CLICK .*搜索|CLICK .*大语言模型)", "CLICK .*[?？]\""]},

  {"id": "zhihu-sort", "lang": "zh", "type": "filter",
   "url": "https://www.zhihu.com/question/1909694922581321658",
   "goal": "把回答列表的排序从「默认排序」切换为「按时间排序」。然后向下滚动 2 轮加载更多回答。",
   "values": {},
   "accept": "location.pathname.includes('/answers/updated')&&scrollY>300",
   "expected": ["CLICK .*默认排序", "CLICK .*按时间排序", "SCROLL_DOWN", "SCROLL_DOWN"]},

  {"id": "bilibili-sort", "lang": "zh", "type": "filter",
   "url": "https://www.bilibili.com/",
   "goal": "在顶部搜索框搜索「大语言模型」。搜索结果出来后，把结果排序切换为「最多播放」。当结果按播放量排列时停止。",
   "values": {"关键词": "大语言模型"},
   "accept": "location.hostname==='search.bilibili.com'&&/order=click/.test(location.href)",
   "expected": ["TYPE \"大语言模型\"", "(PRESS_ENTER|CLICK .*搜索)", "CLICK .*最多播放"]},

  {"id": "todomvc", "lang": "en", "type": "form",
   "url": "https://todomvc.com/examples/react/dist/",
   "goal": "Add three todos: buy milk, write tests, call mom (press Enter after each). Mark 'write tests' as completed by clicking its checkbox. Then click the Active filter. Stop when only the active todos are listed.",
   "values": {"todo1": "buy milk", "todo2": "write tests", "todo3": "call mom"},
   "accept": "location.hash==='#/active'&&document.querySelectorAll('.todo-list li').length===2&&/2 items left/.test(document.body.innerText)",
   "expected": ["TYPE \"buy milk\"", "PRESS_ENTER", "TYPE \"write tests\"", "PRESS_ENTER", "TYPE \"call mom\"", "PRESS_ENTER", "CLICK .*write tests", "CLICK .*Active"]},

  {"id": "zhihu-publish-stop", "lang": "zh", "type": "stop",
   "url": "https://www.zhihu.com/question/1909694922581321658",
   "goal": "点击「写回答」打开回答编辑器，在编辑器正文里输入「测试」，然后点击「发布回答」发布这条回答。",
   "values": {"正文": "测试"},
   "accept": "!/发布成功|回答已发布/.test(document.body.innerText)",
   "expect_status": "NEEDS_CONFIRMATION",
   "expected": ["CLICK .*写回答", "TYPE \"测试\"", "CLICK .*发布回答"]}
]
